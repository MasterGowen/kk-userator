# Переменные окружения для Keycloak User Generator
# Скопируйте этот файл в .env и заполните значения
#
# Использование:
#   1. cp .env.example .env
#   2. Отредактируйте .env, указав ваши данные
#   3. Запустите: python -m keycloak_userator.cli

# =============================================================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ (для неинтерактивного режима)
# =============================================================================

# URL сервера Keycloak
# Поддерживаются URL с поддиректорией: https://openedu.urfu.ru/auth/
KEYCLOAK_URL=https://keycloak.urfu.online

# Имя пользователя администратора Keycloak
# Требуется роль realm-admin или эквивалентные права
KEYCLOAK_USERNAME=admin

# Пароль администратора Keycloak
KEYCLOAK_PASSWORD=your_password_here

# =============================================================================
# ОПЦИОНАЛЬНЫЕ ПЕРЕМЕННЫЕ
# =============================================================================

# Realm (по умолчанию: master)
KEYCLOAK_REALM=master

# Путь к файлу конфигурации YAML (по умолчанию: config.yaml)
# KEYCLOAK_CONFIG=config.yaml

# =============================================================================
# ПЕРЕМЕННЫЕ ДЛЯ ПЕРЕОПРЕДЕЛЕНИЯ ПАРАМЕТРОВ ИЗ CONFIG.YAML
# Приоритет: CLI arg > env var > config.yaml > default
# =============================================================================

# Префикс для логинов пользователей (по умолчанию: из config.yaml)
# Должен содержать только латиницу, цифры и подчёркивание
# KEYCLOAK_LOGIN_PREFIX=enginc

# Домен для email адресов пользователей (по умолчанию: из config.yaml)
# KEYCLOAK_EMAIL_DOMAIN=urfu.online

# Количество пользователей для создания (по умолчанию: из config.yaml)
# KEYCLOAK_COUNT=200

# Директория для файлов с учётными данными (по умолчанию: из config.yaml)
# KEYCLOAK_OUTPUT_DIR=output

# =============================================================================
# ПРИМЕРЫ ИСПОЛЬЗОВАНИЯ
# =============================================================================
#
# Неинтерактивный режим (переменные окружения):
#   python -m keycloak_userator.cli
#
# Интерактивный режим (запрос данных):
#   python -m keycloak_userator.cli --interactive
#
# Создание 50 пользователей:
#   python -m keycloak_userator.cli --count 50
#
# Режим сухой проверки (без реального создания):
#   python -m keycloak_userator.cli --dry-run
#
# Переопределение параметров через env:
#   export KEYCLOAK_LOGIN_PREFIX=mycourse
#   export KEYCLOAK_COUNT=100
#   python -m keycloak_userator.cli
# =============================================================================
