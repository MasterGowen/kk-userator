# Переменные окружения для Keycloak User Generator
# Скопируйте этот файл в .env и заполните значения

# URL сервера Keycloak (обязательно)
KEYCLOAK_URL=https://keycloak.urfu.online

# Имя пользователя администратора (обязательно)
KEYCLOAK_USERNAME=admin

# Пароль администратора (обязательно)
KEYCLOAK_PASSWORD=your_password_here

# Realm (опционально, по умолчанию: master)
KEYCLOAK_REALM=master

# Путь к файлу конфигурации (опционально, по умолчанию: config.yaml)
# KEYCLOAK_CONFIG=config.yaml
