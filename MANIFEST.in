# MANIFEST.in — дополнительные файлы для включения в пакет
# См: https://setuptools.pypa.io/en/latest/userguide/datafiles.html

# Включить py.typed для типизации
recursive-include src/keycloak_userator py.typed

# Включить README и LICENSE
include README.md
include LICENSE

# Включить документацию для разработчиков (кроме внутренних аудитов)
recursive-include docs *.md
exclude docs/deviation-audit-*.md
exclude docs/audit-review-*.md
exclude docs/audit-report.*

# Тесты включаются автоматически (стандарт для Python-пакетов)
# Исходники в src/ включаются автоматически через pyproject.toml
